# ---- Browser-safe values (also needed at build time) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# ---- Trio AI Assistant (Google Gemini): SERVER-ONLY secrets. Set these in Render's Environment tab. ----
# Never put them in a real .env that is committed, and never prefix them with VITE_.
# GEMINI_API_KEY=AIza...                       (required for the assistant)
# GEMINI_MODEL=gemini-3.8-flash                (optional; this is the default)
# GEMINI_THINKING_LEVEL=low                    (optional: low | medium | high | default)
